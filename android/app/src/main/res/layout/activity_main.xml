<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:id="@+id/root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="28dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" tools:ignore="UseCompoundDrawables">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="14dp" android:importantForAccessibility="no" android:src="@mipmap/ic_launcher" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/app_name" android:textAppearance="@android:style/TextAppearance.Material.Headline" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/home_subtitle" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
        <TextView style="@style/SectionTitle" android:text="@string/session_title" />
        <TextView android:id="@+id/session_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:textAppearance="@android:style/TextAppearance.Material.Body1" android:textStyle="bold" />
        <Button android:id="@+id/session_action" style="@android:style/Widget.Material.Button.Colored" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:visibility="gone" />
        <Button android:id="@+id/session_start" style="@android:style/Widget.Material.Button.Colored" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="56dp" android:text="@string/session_start" />
        <Button android:id="@+id/session_end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/session_end" android:visibility="gone" />
        <Button android:id="@+id/steps_toggle" style="@android:style/Widget.Material.Button.Borderless" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" />
        <LinearLayout android:id="@+id/steps_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/setup_1" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/setup_2" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/setup_3" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <dev.patotective.duckpad.PairingChoiceView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/setup_4" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
        </LinearLayout>
        <TextView style="@style/SectionTitle" android:text="@string/settings_title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/orientation_label" android:layout_marginTop="14dp" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
        <RadioGroup android:id="@+id/orientation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/landscape" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="@string/landscape" />
            <RadioButton android:id="@+id/portrait" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="@string/portrait" />
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/orientation_help" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
        <Button android:id="@+id/edit_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/edit_layout" />
        <Switch android:id="@+id/volume_enable" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="@string/volume_enable" />
        <LinearLayout android:id="@+id/volume_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/volume_help" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/volume_up_label" android:layout_marginTop="12dp" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <Spinner android:id="@+id/volume_up" android:layout_width="match_parent" android:layout_height="52dp" android:contentDescription="@string/volume_up_label" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/volume_down_label" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <Spinner android:id="@+id/volume_down" android:layout_width="match_parent" android:layout_height="52dp" android:contentDescription="@string/volume_down_label" />
        </LinearLayout>
        <Switch android:id="@+id/haptics" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/haptics" />
        <Button android:id="@+id/advanced_toggle" style="@android:style/Widget.Material.Button.Borderless" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:minHeight="48dp" />
        <LinearLayout android:id="@+id/advanced_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/SectionTitle" android:layout_marginTop="8dp" android:text="@string/identity_title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/identity_help" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/identity_default_note" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/identity_responsibility" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <TextView android:id="@+id/identity_locked" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/identity_locked" android:textAppearance="@android:style/TextAppearance.Material.Body1" android:textStyle="bold" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/identity_slot_label" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <RadioGroup android:id="@+id/identity_slot" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <RadioButton android:id="@+id/identity_slot_a" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:fontFamily="monospace" />
                <RadioButton android:id="@+id/identity_slot_b" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:fontFamily="monospace" />
            </RadioGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/identity_slot_help" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:baselineAligned="false" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:id="@+id/identity_vid_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:labelFor="@+id/identity_vid" android:text="@string/identity_vid" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
                    <EditText android:id="@+id/identity_vid" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:digits="0123456789ABCDEFabcdef" android:fontFamily="monospace" android:imeOptions="actionNext" android:importantForAutofill="no" android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword" android:maxLength="4" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:id="@+id/identity_pid_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:labelFor="@+id/identity_pid" android:text="@string/identity_pid" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
                    <EditText android:id="@+id/identity_pid" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:digits="0123456789ABCDEFabcdef" android:fontFamily="monospace" android:imeOptions="actionNext" android:importantForAutofill="no" android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword" android:maxLength="4" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/identity_version_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:labelFor="@+id/identity_version" android:text="@string/identity_version" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
                    <EditText android:id="@+id/identity_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:digits="0123456789ABCDEFabcdef" android:fontFamily="monospace" android:imeOptions="actionDone" android:importantForAutofill="no" android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword" android:maxLength="4" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/identity_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:textAppearance="@android:style/TextAppearance.Material.Body1" android:visibility="gone" />
            <Button android:id="@+id/identity_save" style="@android:style/Widget.Material.Button.Colored" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/identity_save" />
            <Button android:id="@+id/identity_reset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/identity_reset" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:gravity="center_horizontal" android:text="@string/credit" android:textAppearance="@android:style/TextAppearance.Material.Body1" />
    </LinearLayout>
</ScrollView>