<?xml version="1.0" encoding="utf-8"?>
<!-- Los ajustes (posiciones, PCs vinculados, identidad) no salen del móvil: sin copia en la nube ni al pasar a otro móvil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
